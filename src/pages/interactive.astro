---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const all = await getCollection('interactive');
const instruments = all.filter((e) => e.data.kind === 'instrument').sort((a, b) => (b.data.year ?? 0) - (a.data.year ?? 0));
const generative = all.filter((e) => e.data.kind === 'generative').sort((a, b) => a.data.title.localeCompare(b.data.title));
---

<Base
  title="Interactive"
  description="Playable browser instruments and generative sound pieces by Kerem Altaylar — microtonal synthesis, gesture sonification, sequencers and generative systems."
>
  <div class="wrap">
    <header class="page-head rise">
      <p class="eyebrow">Interactive</p>
      <h1>Instruments you can play in the browser</h1>
      <p class="lede">
        Every piece below runs in this tab — no install, no plugin. Instruments make
        sound when you interact with them; the generative pieces run on their own.
      </p>
    </header>

    <section aria-labelledby="instruments">
      <h2 id="instruments" class="section-title">Instruments</h2>
      <ul class="inst-grid">
        {
          instruments.map((e) => (
            <li class="card">
              <div class="card-top">
                <h3 class="card-title">{e.data.title}</h3>
                {e.data.year && <span class="meta">{e.data.year}</span>}
              </div>
              {e.data.blurb && <p class="blurb">{e.data.blurb}</p>}
              {e.data.tech.length > 0 && (
                <ul class="tech">
                  {e.data.tech.map((t) => (
                    <li class="meta">{t}</li>
                  ))}
                </ul>
              )}
              <p class="actions">
                <a class="play" href={e.data.url} rel="noopener">Play in browser →</a>
                {e.data.repo && <a class="src" href={e.data.repo} rel="noopener">Source</a>}
              </p>
            </li>
          ))
        }
      </ul>
    </section>

    <hr class="rule" />

    <section aria-labelledby="generative">
      <h2 id="generative" class="section-title">Generative pieces</h2>
      <p class="section-note">
        {generative.length} browser-based generative systems. Each one is a running
        process rather than a fixed image.
      </p>
      <ul class="gen-grid">
        {
          generative.map((e) => (
            <li>
              <a href={e.data.url} rel="noopener">
                <span class="gen-title">{e.data.title}</span>
                <span class="meta gen-open">Open →</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</Base>

<style>
  .page-head {
    padding-block: clamp(3rem, 9vw, 6rem) clamp(2rem, 5vw, 3.5rem);
    max-width: 46rem;
  }
  .page-head h1 {
    margin-block: 0.6rem 1rem;
  }
  .lede {
    font-size: 1.15rem;
    opacity: 0.82;
  }

  .section-title {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 1.6rem;
  }
  .section-note {
    margin-top: -0.9rem;
    margin-bottom: 1.8rem;
    color: var(--dim);
  }

  .inst-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: 1px;
    background: var(--bdr);
    border: 1px solid var(--bdr);
  }
  .card {
    background: var(--bg);
    padding: clamp(1.4rem, 3vw, 2rem);
    display: flex;
    flex-direction: column;
    transition: background 0.5s ease;
  }
  .card:hover {
    background: var(--bg-raised);
  }
  .card-top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }
  .card-title {
    font-family: var(--font-display);
    font-size: 1.5rem;
    letter-spacing: 0;
    text-transform: none;
    color: var(--ink);
  }
  .blurb {
    margin-top: 0.7rem;
    opacity: 0.8;
    font-size: 0.98rem;
    flex: 1;
  }
  .tech {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
  }
  .tech li {
    border: 1px solid var(--bdr);
    padding: 0.2rem 0.5rem;
    font-size: 0.6rem;
  }
  .actions {
    margin-top: 1.5rem;
    display: flex;
    align-items: baseline;
    gap: 1.4rem;
  }
  .play {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gold);
    text-decoration: none;
  }
  .src {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--dim);
    text-decoration: none;
  }

  .gen-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 13rem), 1fr));
    gap: 1px;
    background: var(--bdr);
    border: 1px solid var(--bdr);
  }
  .gen-grid a {
    background: var(--bg);
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.8rem;
    padding: 1.1rem 1.2rem;
    text-decoration: none;
    transition: background 0.4s ease;
  }
  .gen-grid a:hover {
    background: var(--bg-raised);
  }
  .gen-title {
    font-family: var(--font-display);
    font-size: 1.15rem;
  }
  .gen-open {
    color: var(--gold);
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .gen-grid a:hover .gen-open {
    opacity: 1;
  }
</style>
