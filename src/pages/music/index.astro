---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import WorkRow from '../../components/WorkRow.astro';

const all = await getCollection('works', ({ data }) => data.status === 'published');
type Work = (typeof all)[number];
const byDate = (a: Work, b: Work) => b.data.year - a.data.year || a.data.order - b.data.order;

/* Compositions are the spatial pieces. Anything typed `performance` lives on the
   performances page instead, though its detail page is still built and linked. */
const spatial = all.filter((w) => w.data.type === 'composition').sort(byDate);

/* The loader does not preserve file order, so sort explicitly. Anything without a
   year is the newest thing he has put out and sits at the top. */
const releases = (await getCollection('releases')).sort(
  (a, b) => (b.data.year ?? Infinity) - (a.data.year ?? Infinity)
);
const scoring = (await getCollection('scoring')).sort((a, b) => b.data.year - a.data.year);
---

<Base
  title="Music & Sound"
  description="Music by sound artist Kerem Altaylar — albums, spatial multichannel compositions built from field recordings, and music written for theatre, dance and film."
>
  <div class="wrap">
    <header class="page-head rise">
      <p class="eyebrow">Music &amp; Sound</p>
      <h1>Releases &amp; compositions</h1>
      <p class="lede">
        Albums, spatial work built from recordings of things too quiet, too small or too
        slow to hear, and music written for other people's stages and screens.
      </p>
    </header>

    <nav class="jump" aria-label="Sections">
      <a href="#releases">Releases</a>
      <a href="#spatial">Spatial compositions</a>
      <a href="#scoring">Stage &amp; screen</a>
    </nav>

    <section id="releases" aria-labelledby="releases-h">
      <h2 id="releases-h" class="section-title">Releases</h2>
      <ul class="listing">
        {
          releases.map((r) => (
            <li>
              <a href={r.data.url} rel="noopener">
                <span class="line-title">{r.data.title}</span>
                <span class="tags">
                  <span class="tag">Album</span>
                  {r.data.year && <span class="meta">{r.data.year}</span>}
                  <span class="meta">{r.data.label ?? 'Bandcamp'}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section id="spatial" aria-labelledby="spatial-h">
      <h2 id="spatial-h" class="section-title">Spatial compositions</h2>
      <div class="prose intro">
        <p>
          Multichannel pieces that begin with a microphone somewhere it does not
          normally go — inside bark, against soil, pressed to the wall of an ant
          habitat. The recordings are the whole palette; the work is what happens to
          them afterwards, composed into a fixed image for an array of speakers so the
          audience sits inside the material rather than in front of it.
        </p>
      </div>
      {spatial.map((work, i) => <WorkRow work={work} index={i} />)}
    </section>

    <section id="scoring" aria-labelledby="scoring-h">
      <h2 id="scoring-h" class="section-title">Music for stage &amp; screen</h2>
      <ul class="listing">
        {
          scoring.map((s) => {
            const line = (
              <>
                <span class="line-title">{s.data.title}</span>
                <span class="tags">
                  <span class="tag">{s.data.medium}</span>
                  <span class="meta">{s.data.year}</span>
                  {s.data.context && <span class="meta">{s.data.context}</span>}
                </span>
                <span class="role meta">{s.data.role}</span>
                {s.data.blurb && <p class="blurb">{s.data.blurb}</p>}
              </>
            );
            return (
              <li>
                {s.data.url ? (
                  <a href={s.data.url} rel="noopener">
                    {line}
                  </a>
                ) : (
                  <div class="static">{line}</div>
                )}
              </li>
            );
          })
        }
      </ul>
    </section>
  </div>
</Base>

<style>
  .page-head {
    padding-block: clamp(3rem, 9vw, 6rem) clamp(1rem, 3vw, 2rem);
    max-width: 46rem;
  }
  .page-head h1 {
    margin-block: 0.6rem 1rem;
  }
  .lede {
    font-size: 1.15rem;
    opacity: 0.85;
  }

  .jump {
    display: flex;
    flex-wrap: wrap;
    gap: 1.6rem;
    padding-block: 1.1rem;
    border-block: 1px solid var(--bdr);
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }
  .jump a {
    color: var(--dim);
    text-decoration: none;
  }
  .jump a:hover {
    color: var(--accent);
  }

  section {
    padding-top: clamp(2.5rem, 7vw, 5rem);
    scroll-margin-top: 6rem;
  }
  .section-title {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 1.6rem;
  }
  .intro {
    max-width: var(--measure);
    margin-bottom: clamp(1rem, 3vw, 1.5rem);
    opacity: 0.85;
  }

  /* Releases and scoring share one row style so the page reads as one register. */
  .listing {
    list-style: none;
    border-top: 1px solid var(--bdr);
  }
  .listing a,
  .listing .static {
    display: block;
    padding-block: 1.4rem;
    border-bottom: 1px solid var(--bdr);
    text-decoration: none;
  }
  .line-title {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 3vw, 2rem);
    transition: color 0.4s ease;
  }
  .listing a:hover .line-title {
    color: var(--accent);
  }

  /* The tag names the kind of thing this is; the rest of the row dates and places it. */
  .tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.55rem 0.9rem;
    margin-top: 0.5rem;
  }
  .tag {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
    border: 1px solid var(--bdr);
    border-radius: 999px;
    padding: 0.25rem 0.6rem;
  }
  .tags .meta {
    text-transform: none;
  }
  .role {
    display: block;
    margin-top: 0.5rem;
    text-transform: none;
    letter-spacing: 0.06em;
  }
  .blurb {
    max-width: var(--measure);
    margin-top: 0.6rem;
    opacity: 0.8;
  }
</style>
