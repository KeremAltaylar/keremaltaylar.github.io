---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Gallery from '../components/Gallery.astro';
import { PERFORMANCE_PHOTOS, LIVE_CODING } from '../data/galleries';

/** Kept here rather than in a collection: it is a flat list that only ever grows.
    The fourth entry links to the piece's page where one exists. */
const past: [string, string, string, string?][] = [
  ['2025', 'Inside the Tribe', 'Sonic Provocations, Sonified III, Arter, Istanbul', '/music/inside-the-tribe/'],
  ['2025', 'Colony', 'Podium für MIAM, Hochschule für Musik, Theater und Medien Hannover', '/music/the-colony/'],
  ['2024', 'Hammers of the Bruenor', 'Sonified II, Arter, Istanbul', '/music/hammers-of-the-bruenor/'],
  ['2023', 'Solo live coding', 'Sónar İstanbul'],
  ['2022', 'Solo live coding', 'Generate İstanbul, Babylon'],
  ['2022', 'Solo live coding', 'Gazhane Museum, Istanbul'],
  ['2021', 'Decentralisation of Homo Heidelbergensis', 'MIAM Gallery, Istanbul'],
  ['2018–present', 'Y Negative & Pembe', 'Babylon · Gazhane Museum · Blind Istanbul'],
];

const today = new Date().toISOString().slice(0, 10);
const upcoming = (await getCollection('events'))
  .filter((e) => e.data.date >= today)
  .sort((a, b) => a.data.date.localeCompare(b.data.date));
---

<Base
  title="Performances"
  description="Live performances by Kerem Altaylar — multichannel diffusion, live electronics and live coding at Arter, Sónar İstanbul, Hochschule für Musik Hannover and Babylon."
>
  <div class="wrap">
    <header class="page-head rise">
      <p class="eyebrow">Performances</p>
      <h1>On stage</h1>
      <p class="lede">
        Live electronics, multichannel diffusion, live coding and drumming — in concert
        halls, galleries, clubs and atria, wherever there are enough speakers to put the
        audience inside the piece rather than in front of it.
      </p>
    </header>

    <section aria-labelledby="photos-h">
      <h2 id="photos-h" class="section-title">Selected nights</h2>
      <Gallery photos={PERFORMANCE_PHOTOS} />
    </section>

    {
      upcoming.length > 0 && (
        <section aria-labelledby="upcoming-h">
          <h2 id="upcoming-h" class="section-title">Upcoming</h2>
          <ul class="entries">
            {upcoming.map((e) => (
              <li>
                <span class="when meta">{e.data.date}</span>
                <span class="what">
                  {e.data.url ? (
                    <a href={e.data.url} rel="noopener">
                      {e.data.title}
                    </a>
                  ) : (
                    e.data.title
                  )}
                  <span class="where">{[e.data.venue, e.data.city].filter(Boolean).join(', ')}</span>
                </span>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section aria-labelledby="past-h">
      <h2 id="past-h" class="section-title">Selected performances</h2>
      <ul class="entries">
        {
          past.map(([when, what, where, href]) => (
            <li>
              <span class="when meta">{when}</span>
              <span class="what">
                {href ? <a href={href}>{what}</a> : what}
                <span class="where">{where}</span>
              </span>
            </li>
          ))
        }
      </ul>
    </section>

    <section aria-labelledby="live-coding-h">
      <h2 id="live-coding-h" class="section-title">Live coding</h2>
      <div class="prose intro">
        <p>
          Sound and image written from scratch in front of an audience, the source
          projected as it is edited so the piece and its construction stay visible at
          once. The material is rule-based rather than improvised note by note: a
          system is set running, and the performance is the negotiation with it.
        </p>
      </div>
      <Gallery photos={LIVE_CODING} />
      <p class="aside meta">
        Full history, teaching and residencies on the <a href="/cv/">CV</a>. For booking,
        write to <a href="mailto:keremaltaylar@gmail.com">keremaltaylar@gmail.com</a>.
      </p>
    </section>
  </div>
</Base>

<style>
  .page-head {
    padding-block: clamp(3rem, 9vw, 6rem) clamp(1rem, 3vw, 2rem);
    max-width: 46rem;
  }
  .page-head h1 {
    margin-block: 0.6rem 1rem;
  }
  .lede {
    font-size: 1.15rem;
    opacity: 0.85;
  }

  section {
    padding-top: clamp(2.5rem, 7vw, 4.5rem);
  }
  .section-title {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 1.6rem;
  }

  .entries {
    list-style: none;
    border-top: 1px solid var(--bdr);
  }
  .entries li {
    display: grid;
    grid-template-columns: 11rem 1fr;
    gap: 1.5rem;
    padding-block: 0.95rem;
    border-bottom: 1px solid var(--bdr);
  }
  .when {
    padding-top: 0.35rem;
  }
  .what {
    display: grid;
    gap: 0.15rem;
    font-family: var(--font-display);
    font-size: 1.35rem;
  }
  .where {
    color: var(--dim);
    font-family: var(--font-body);
    font-size: 0.9rem;
  }

  .intro {
    max-width: var(--measure);
    margin-bottom: clamp(1.2rem, 3vw, 2rem);
    opacity: 0.85;
  }
  .what a {
    text-decoration: none;
    border-bottom: 1px solid var(--bdr);
  }
  .what a:hover {
    color: var(--accent);
  }

  .aside {
    margin-top: 1.8rem;
    text-transform: none;
    letter-spacing: 0.06em;
    font-size: 0.8rem;
  }

  @media (max-width: 700px) {
    .entries li {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }
  }
</style>
