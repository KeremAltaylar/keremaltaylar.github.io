---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import WorkRow from '../../components/WorkRow.astro';

const works = (await getCollection('works', ({ data }) => data.status === 'published')).sort(
  (a, b) => b.data.year - a.data.year || a.data.order - b.data.order
);
---

<Base
  title="Works"
  description="Compositions, performances, installations and research by sound artist Kerem Altaylar."
>
  <div class="wrap">
    <header class="page-head rise">
      <p class="eyebrow">Works</p>
      <h1>Compositions, performances &amp; research</h1>
    </header>

    {works.map((work, i) => <WorkRow work={work} index={i} />)}

    {works.length === 0 && <p class="meta">No published works yet.</p>}
  </div>
</Base>

<style>
  .page-head {
    padding-block: clamp(3rem, 9vw, 6rem) clamp(1rem, 3vw, 2rem);
  }
  .page-head h1 {
    margin-top: 0.6rem;
  }
</style>
