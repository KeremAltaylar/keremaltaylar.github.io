---
import Base from '../layouts/Base.astro';
import { SITE } from '../data/site';
---

<Base>
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow rise">{SITE.role}</p>
      <h1 class="rise">Kerem Altaylar</h1>
    </div>
  </section>
</Base>

<style>
  /* The landing page is the background and nothing else — the header nav
     carries every route, so the hero only has to hold the name. */
  .hero {
    min-height: min(60vh, 34rem);
    display: flex;
    align-items: center;
  }
  .hero h1 {
    margin-top: 0.5rem;
    animation-delay: 0.1s;
  }
</style>
