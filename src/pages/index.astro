---
const name = 'Kerem Altaylar';
const role = 'Sound artist, researcher & performer';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{name} — {role}</title>
    <meta
      name="description"
      content={`${name}. ${role}. Generative systems, live electronics, creative coding and immersive audio.`}
    />
    <link rel="canonical" href="https://keremaltaylar.github.io/" />
  </head>
  <body>
    <main>
      <h1>{name}</h1>
      <p class="role">{role}</p>
      <p class="note">New site in progress.</p>
      <p class="note">
        Current work lives at
        <a href="https://keremaltaylar.github.io/Portfolio/">the previous portfolio</a>.
      </p>
    </main>
  </body>
</html>

<style is:global>
  :root {
    --bg: #060504;
    --ink: #dedad2;
    --dim: #4a4740;
    --gold: #b89448;
  }
  *,
  *::before,
  *::after {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }
  body {
    min-height: 100dvh;
    display: grid;
    place-items: center;
    padding: 2rem;
    background: var(--bg);
    color: var(--ink);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    line-height: 1.7;
  }
  main {
    max-width: 34rem;
  }
  h1 {
    font-size: clamp(1.1rem, 4vw, 1.6rem);
    font-weight: 400;
    letter-spacing: 0.3em;
    text-transform: uppercase;
  }
  h1::first-letter {
    color: var(--gold);
  }
  .role {
    margin-top: 0.75rem;
    font-size: 0.8rem;
    color: var(--dim);
  }
  .note {
    margin-top: 1.75rem;
    font-size: 0.75rem;
    color: var(--dim);
  }
  a {
    color: var(--gold);
    text-underline-offset: 0.3em;
  }
</style>
