---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { SITE } from '../data/site';

const works = (await getCollection('works', ({ data }) => data.status === 'published' && data.featured))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

const today = new Date().toISOString().slice(0, 10);
const upcoming = (await getCollection('events'))
  .filter((e) => e.data.date >= today)
  .sort((a, b) => a.data.date.localeCompare(b.data.date));
---

<Base>
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow rise">{SITE.role}</p>
      <h1 class="rise">Kerem Altaylar</h1>
      <p class="intro rise">
        I work with generative systems, live electronics, creative coding and immersive
        audio — building sound from things that are usually too quiet, too small or too
        slow to hear.
      </p>
      <p class="cta rise">
        <a href="/works/">Works</a>
        <a href="/interactive/">Play an instrument →</a>
      </p>
    </div>
  </section>

  <div class="wrap">
    {
      upcoming.length > 0 && (
        <section class="events" aria-labelledby="upcoming">
          <h2 id="upcoming" class="eyebrow">Upcoming</h2>
          <ul>
            {upcoming.map((e) => (
              <li>
                <span class="meta">{e.data.date}</span>
                <span class="ev-title">
                  {e.data.url ? <a href={e.data.url} rel="noopener">{e.data.title}</a> : e.data.title}
                </span>
                <span class="meta">{[e.data.venue, e.data.city].filter(Boolean).join(', ')}</span>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section class="featured" aria-labelledby="selected">
      <h2 id="selected" class="eyebrow">Selected work</h2>
      <ul class="feat-list">
        {
          works.map((w) => (
            <li>
              <a href={`/works/${w.id}/`}>
                <span class="meta">{[w.data.format, String(w.data.year)].filter(Boolean).join(' · ')}</span>
                <span class="feat-title">{w.data.title}</span>
                <span class="feat-summary">{w.data.summary}</span>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="all"><a href="/works/">All works →</a></p>
    </section>
  </div>
</Base>

<style>
  .hero {
    min-height: min(78vh, 40rem);
    display: flex;
    align-items: center;
    padding-block: clamp(4rem, 12vw, 8rem);
  }
  .hero h1 {
    margin-block: 0.5rem 1.5rem;
    animation-delay: 0.1s;
  }
  .intro {
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    max-width: 42ch;
    opacity: 0.84;
    animation-delay: 0.2s;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
    margin-top: 2.5rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    animation-delay: 0.3s;
  }
  .cta a {
    text-decoration: none;
    color: var(--dim);
  }
  .cta a:last-child {
    color: var(--gold);
  }

  .events {
    border-top: 1px solid var(--bdr);
    padding-top: 2rem;
    margin-bottom: clamp(3rem, 8vw, 5rem);
  }
  .events ul {
    list-style: none;
    margin-top: 1.2rem;
  }
  .events li {
    display: grid;
    grid-template-columns: 8rem 1fr auto;
    gap: 1rem;
    padding-block: 0.7rem;
    border-bottom: 1px solid var(--bdr);
    align-items: baseline;
  }
  .ev-title {
    font-family: var(--font-display);
    font-size: 1.2rem;
  }

  .featured {
    border-top: 1px solid var(--bdr);
    padding-top: 2rem;
  }
  .feat-list {
    list-style: none;
    margin-top: 1rem;
  }
  .feat-list a {
    display: grid;
    gap: 0.4rem;
    padding-block: clamp(1.4rem, 3vw, 2rem);
    border-bottom: 1px solid var(--bdr);
    text-decoration: none;
  }
  .feat-title {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3.5vw, 2.4rem);
    transition: color 0.4s ease;
  }
  .feat-list a:hover .feat-title {
    color: var(--gold);
  }
  .feat-summary {
    max-width: 60ch;
    opacity: 0.75;
    font-size: 0.98rem;
  }
  .all {
    margin-top: 2rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }
  .all a {
    color: var(--gold);
    text-decoration: none;
  }

  @media (max-width: 700px) {
    .events li {
      grid-template-columns: 1fr;
      gap: 0.2rem;
    }
  }
</style>
