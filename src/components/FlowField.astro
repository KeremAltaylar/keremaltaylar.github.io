---
/**
 * Layered background: forest photograph, Perlin flow field over it, then a
 * scrim that keeps text legible. All three sit behind content and never
 * intercept pointer events.
 *
 * `still` drops the animated field and fades the photograph back further —
 * used on reading-heavy pages so the atmosphere carries through without
 * competing with long passages of text.
 */
interface Props {
  still?: boolean;
}
const { still = false } = Astro.props;
---

<div class:list={['bg-photo', { still }]} aria-hidden="true"></div>
{!still && <canvas id="flowfield" aria-hidden="true"></canvas>}
<div class:list={['bg-scrim', { still }]} aria-hidden="true"></div>

<style>
  .bg-photo,
  .bg-scrim,
  #flowfield {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .bg-photo {
    z-index: -3;
    background-image: image-set(url('/bg-forest.webp') type('image/webp'), url('/bg-forest.jpg'));
    background-size: cover;
    background-position: center 28%;
    /* Desaturated and lifted toward the palette so it reads as atmosphere
       rather than a photograph competing with the text. */
    filter: saturate(0.55) brightness(1.12) contrast(0.85);
    opacity: 0.82;
  }
  .bg-photo.still {
    opacity: 0.32;
    filter: saturate(0.35) brightness(1) contrast(0.72) blur(2px);
  }

  #flowfield {
    z-index: -2;
    opacity: 0;
    transition: opacity 2.5s ease;
  }
  #flowfield.on {
    opacity: 1;
  }

  /* Deepens the edges and floor so long passages of text stay readable. */
  .bg-scrim {
    z-index: -1;
    background:
      /* Text sits in the left half of the measure, so weight the darkening
         there and leave the right side of the photograph open. */
      linear-gradient(to right, rgba(18, 24, 21, 0.62) 0%, rgba(18, 24, 21, 0.28) 45%, rgba(18, 24, 21, 0) 85%),
      radial-gradient(125% 90% at 50% 28%, rgba(30, 38, 34, 0) 0%, rgba(24, 31, 27, 0.4) 100%),
      linear-gradient(to bottom, rgba(24, 31, 27, 0.28) 0%, rgba(24, 31, 27, 0.2) 40%, rgba(20, 26, 23, 0.64) 100%);
  }
  .bg-scrim.still {
    background: linear-gradient(to bottom, rgba(26, 34, 30, 0.5) 0%, rgba(26, 34, 30, 0.72) 100%);
  }
</style>

<script>
  const cv = document.getElementById('flowfield') as HTMLCanvasElement | null;
  if (cv && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const ctx = cv.getContext('2d', { alpha: true })!;
    const CELL = 24;
    const TAU = Math.PI * 2;

    const noise = (() => {
      const p = [...Array(256).keys()];
      for (let i = 255; i > 0; i--) {
        const j = (Math.random() * (i + 1)) | 0;
        [p[i], p[j]] = [p[j], p[i]];
      }
      const P = new Uint8Array(512);
      for (let i = 0; i < 512; i++) P[i] = p[i & 255];
      const fade = (t: number) => t * t * t * (t * (t * 6 - 15) + 10);
      const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
      const grad = (h: number, x: number, y: number) => {
        switch (h & 3) {
          case 0: return x + y;
          case 1: return -x + y;
          case 2: return x - y;
          default: return -x - y;
        }
      };
      return (x: number, y: number) => {
        const X = Math.floor(x) & 255, Y = Math.floor(y) & 255;
        x -= Math.floor(x); y -= Math.floor(y);
        const u = fade(x), v = fade(y);
        const A = P[X] + Y, B = P[X + 1] + Y;
        return lerp(
          lerp(grad(P[A], x, y), grad(P[B], x - 1, y), u),
          lerp(grad(P[A + 1], x, y - 1), grad(P[B + 1], x - 1, y - 1), u),
          v
        );
      };
    })();

    let W = 0, H = 0, cols = 0, rows = 0;
    let field = new Float32Array(0);
    let dpr = 1;

    function resize() {
      dpr = Math.min(devicePixelRatio || 1, 1.5);
      W = innerWidth;
      H = innerHeight;
      cv!.width = Math.floor(W * dpr);
      cv!.height = Math.floor(H * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      cols = Math.ceil(W / CELL) + 2;
      rows = Math.ceil(H / CELL) + 2;
      field = new Float32Array(cols * rows);
      ctx.clearRect(0, 0, W, H);
    }

    /* Three tones lifted from the photograph: pale overcast sky, sage, and a
       soft olive drawn from the meadow. Pastel rather than saturated, so the
       field reads as mist rather than sparks. */
    const TONES: [number, number, number][] = [
      [198, 208, 214], // sky
      [178, 198, 172], // sage
      [140, 150, 118], // meadow
    ];
    const PAL: [number, number, number][] = [];
    for (let i = 0; i < 512; i++) {
      const base = TONES[(Math.random() * TONES.length) | 0];
      const t = 0.72 + Math.random() * 0.28;
      PAL.push([(base[0] * t) | 0, (base[1] * t) | 0, (base[2] * t) | 0]);
    }

    class Particle {
      x = 0; y = 0; vx = 0; vy = 0;
      age = 0; rate = 0; spd = 0; sz = 0;
      r = 0; g = 0; b = 0;
      constructor() { this.reset(true); }
      reset(fresh: boolean) {
        this.x = Math.random() * W;
        this.y = Math.random() * H;
        this.vx = (Math.random() - 0.5) * 0.4;
        this.vy = (Math.random() - 0.5) * 0.4;
        this.age = fresh ? Math.random() : 0;
        this.rate = 0.0012 + Math.random() * 0.0016;
        this.spd = 0.22 + Math.random() * 0.85;
        this.sz = 0.18 + Math.random() * 0.7;
        const c = PAL[(Math.random() * PAL.length) | 0];
        [this.r, this.g, this.b] = c;
      }
      step() {
        const gx = Math.min(Math.max((this.x / CELL) | 0, 0), cols - 1);
        const gy = Math.min(Math.max((this.y / CELL) | 0, 0), rows - 1);
        const ang = field[gy * cols + gx] || 0;
        const I = 0.96;
        this.vx = this.vx * I + Math.cos(ang) * this.spd * (1 - I);
        this.vy = this.vy * I + Math.sin(ang) * this.spd * (1 - I);
        this.x += this.vx;
        this.y += this.vy;
        this.age += this.rate;
        if (this.x < -2) this.x = W + 2; else if (this.x > W + 2) this.x = -2;
        if (this.y < -2) this.y = H + 2; else if (this.y > H + 2) this.y = -2;
        if (this.age >= 1) this.reset(false);
      }
      draw() {
        const a = Math.sin(this.age * Math.PI);
        if (a < 0.01) return;
        ctx.globalAlpha = a * 0.34;
        ctx.fillStyle = `rgb(${this.r},${this.g},${this.b})`;
        ctx.beginPath();
        ctx.arc(this.x, this.y, this.sz, 0, TAU);
        ctx.fill();
      }
    }

    resize();
    let particles: Particle[] = [];
    function seed() {
      const target = Math.min(3600, Math.round((W * H) / 620));
      particles = Array.from({ length: target }, () => new Particle());
    }
    seed();

    let t = 0;
    let raf = 0;
    let running = true;

    function frame() {
      t += 0.0016;
      for (let y = 0; y < rows; y++) {
        for (let x = 0; x < cols; x++) {
          field[y * cols + x] = noise(x * 0.055, y * 0.055 + t) * Math.PI * 2.2;
        }
      }
      /* Fade previous frames by erasing rather than painting over, so the
         photograph beneath stays visible instead of being covered up. */
      ctx.globalCompositeOperation = 'destination-out';
      ctx.globalAlpha = 1;
      ctx.fillStyle = 'rgba(0,0,0,0.055)';
      ctx.fillRect(0, 0, W, H);
      ctx.globalCompositeOperation = 'source-over';
      for (const p of particles) { p.step(); p.draw(); }
      raf = requestAnimationFrame(frame);
    }

    let resizeTimer: number;
    addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => { resize(); seed(); }, 200);
    });

    document.addEventListener('visibilitychange', () => {
      if (document.hidden && running) { cancelAnimationFrame(raf); running = false; }
      else if (!document.hidden && !running) { running = true; frame(); }
    });

    cv.classList.add('on');
    frame();
  }
</script>
